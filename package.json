{
  "name": "readix",
  "version": "1.0.6",
  "description": "本地化轻量级RSS阅读器",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite --force",
    "dev:electron": "tsc -p tsconfig.electron.json && electron .",
    "build": "npm run build:vite && npm run build:electron",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "release": "npm run build && electron-builder --publish always"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@mozilla/readability": "^0.6.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/jsdom": "^21.1.7",
    "@types/lodash.mergewith": "^4.6.9",
    "@types/mozilla-readability": "^0.2.1",
    "@types/react-virtualized-auto-sizer": "^1.0.4",
    "@types/react-window": "^1.8.8",
    "@types/uuid": "^10.0.0",
    "antd": "^5.26.5",
    "axios": "^1.10.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "electron-log": "^5.4.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.6.2",
    "framer-motion": "^12.23.6",
    "jsdom": "^26.1.0",
    "lodash.mergewith": "^4.6.2",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "node-fetch": "^2.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-pull-to-refresh": "^2.0.1",
    "react-resizable-panels": "^3.0.3",
    "react-router-dom": "^7.7.0",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "react-zoom-pan-pinch": "^3.7.0",
    "rss-parser": "^3.13.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/node-fetch": "^2.6.12",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "typescript": "^5.2.2",
    "vite": "^7.0.5"
  },
  "build": {
    "appId": "com.readix.app",
    "productName": "Readix",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "mac": {
      "category": "public.app-category.news",
      "icon": "assets/icons.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/imhaisu/Readix/releases/download/v${version}"
      }
    ]
  }
}
